{
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "python3 build_routes.py --pages",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(courses|states|pricing|wisconsin|florida-contractor|louisiana|minnesota|michigan|arizona|georgia|tennessee|new-york-city|colorado|north-carolina|south-carolina|nascla-journeyman|nascla-electrical-contractor|nascla-residential-electrical|florida-electrical|alabama|alaska|arkansas|california|connecticut|delaware|hawaii|idaho|illinois|indiana|iowa|kansas|missouri|maryland|mississippi|massachusetts|kentucky|maine|nebraska|new-hampshire|new-mexico|new-jersey|nevada|montana|oklahoma|ohio|pennsylvania|north-dakota|oregon|rhode-island|south-dakota|utah|vermont|virginia|washington|west-virginia|wyoming|new-york|nascla|texas)",
      "destination": "/index.html"
    }
  ]
}
